---
layout: null
permalink: /search.json
sitemap: false
---
{%- assign docs = site.posts | concat: site.patterns | concat: site.glossary -%}
[
{% for doc in docs %}{
"title": {{ doc.title | jsonify }},
"url": {{ doc.url | relative_url | jsonify }},
"kicker": {{ doc.kicker | jsonify }},
"topic": {% if doc.collection == "posts" %}{{ doc.topic | jsonify }}{% else %}"Reference"{% endif %},
"date": {% if doc.collection == "posts" %}{{ doc.date | date: "%b %-d, %Y" | jsonify }}{% else %}""{% endif %},
"description": {{ doc.description | jsonify }},
"body": {{ doc.content | strip_html | strip_newlines | truncatewords: 350 | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}]
